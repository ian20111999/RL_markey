# Dockerfile for Dashboard Services
FROM python:3.10-slim

# 設定工作目錄
WORKDIR /app

# 安裝系統依賴
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 複製 requirements
COPY requirements.txt .

# 安裝 Python 套件
RUN pip install --no-cache-dir -r requirements.txt

# 複製應用程式碼
COPY . .

# 建立必要的目錄
RUN mkdir -p logs models runs plots production/templates frontend/dashboards

# 設定環境變數
ENV PYTHONUNBUFFERED=1
ENV DB_TYPE=postgresql

# 引數：指定要運行的 dashboard 類型
ARG DASHBOARD_TYPE=web

# 根據類型設定啟動命令
CMD if [ "$DASHBOARD_TYPE" = "web" ]; then \
        python web_dashboard.py --host 0.0.0.0 --port 5555; \
    elif [ "$DASHBOARD_TYPE" = "monitoring" ]; then \
        python monitoring_dashboard.py --mode server --host 0.0.0.0 --port 5556; \
    elif [ "$DASHBOARD_TYPE" = "production" ]; then \
        cd production && python dashboard.py --host 0.0.0.0 --port 8080; \
    else \
        echo "Unknown DASHBOARD_TYPE: $DASHBOARD_TYPE" && exit 1; \
    fi

# 健康檢查端口根據類型不同
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD if [ "$DASHBOARD_TYPE" = "web" ]; then \
        curl -f http://localhost:5555/api/health || exit 1; \
    elif [ "$DASHBOARD_TYPE" = "monitoring" ]; then \
        curl -f http://localhost:5556/api/health || exit 1; \
    elif [ "$DASHBOARD_TYPE" = "production" ]; then \
        curl -f http://localhost:8080/health || exit 1; \
    fi
