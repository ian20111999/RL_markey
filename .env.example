# Database Configuration
DB_TYPE=postgresql  # sqlite or postgresql

# PostgreSQL Settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rl_market
POSTGRES_USER=rl_user
POSTGRES_PASSWORD=your_secure_password_here

# PostgreSQL Connection Pool
POSTGRES_MIN_CONN=1
POSTGRES_MAX_CONN=10

# SQLite Settings (fallback)
SQLITE_DB_PATH=logs/metrics.db

# Dashboard Ports
WEB_DASHBOARD_PORT=5555
MONITORING_DASHBOARD_PORT=5556
PRODUCTION_DASHBOARD_PORT=8080

# Training Settings
CUDA_VISIBLE_DEVICES=0

# Logging
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# Application Settings
APP_ENV=production  # development, production
DEBUG=false

# Backup Settings
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
